# Порт для сервера Express
PORT=3001

# Список разрешённых CORS-источников через запятую.
# Пиши *, чтобы разрешить любой источник (например, для быстрого локального тестирования).
CORS_ORIGIN=http://localhost:5173

# учётные данные инстанса green-api (из личного кабинета)
GREEN_API_URL=https://4100.api.green-api.com
GREEN_API_ID_INSTANCE=000000000000
GREEN_API_TOKEN_INSTANCE=your_token_here

# Интервал опроса (мс) для ReceiveNotification
GREEN_API_POLL_INTERVAL=2000
